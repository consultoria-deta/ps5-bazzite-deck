PS5 display: hdmi.verde_snapshot, a read-only dump of the VERDE bridge's registers (test kernels only)

- Off by default (hdmi.verde_snapshot=0, 0444). With 1 on the kernel command line, the first hdmiSystemResume
  reads 49 register blocks (588 registers) over ICC before Linux sends the bridge any command, and prints them
  to dmesg and /sys/kernel/debug/verde_snapshot. With 2 it also reads 8 status registers
  (0x11, 0x13, 0x16, 0xf1, 0xf2, 0x102, 0x300a, 0x9002). It writes nothing to the bridge.
- Purpose: compare the state the PS5 OS leaves the bridge in (HDR on vs off, multichannel audio) with what
  Linux programs, to find what HDR and multichannel LPCM on VERDE would need.
- Not in patches/series: apply it by hand on top of ps5-display.patch for a test kernel.

Tested: PS5 Slim CFI-2115 (VERDE), kernel 7.3.3 of PS5 Bazzite Deck v2.10 with this patch, module ABI unchanged;
two starts with hdmi.verde_snapshot=1 (PS5 OS HDR on, then off): 49 reads each, identical values, normal start
afterwards (picture, sound, Steam). Not re-applied on the v2.14 kernel tree.

Prepared with AI assistance (Claude), reviewed and tested as stated.

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -24,6 +24,8 @@
 #include <drm/drm_drv.h>
 #include <drm/drm_fb_helper.h>
 #include <drm/drm_modeset_lock.h>
+#include <linux/debugfs.h>
+#include <linux/slab.h>
 
 #define HDMI_IC_TYPE_FLAVA3	2
 #define HDMI_IC_TYPE_VERDE	3
@@ -555,10 +557,177 @@
 	i2c_init(4);
 	i2c_cmd_5_4(enable);
 	i2c_exec();
+}
+
+/*
+ * VERDE-SNAP (test kernel, READ ONLY). Off by default.
+ *
+ * hdmi.verde_snapshot=1 on the command line dumps the VERDE bridge registers as the PS5 OS
+ * left them, before Linux sends its first command to the bridge: this runs at the top of
+ * the first hdmiSystemResume() (spcie_icc_init: getHdmiConfiguration -> here -> 5/4 event
+ * enable -> sceHdmiInitVideoConfig/initVerde). Without the parameter nothing below runs.
+ *
+ * The only bridge command sent is the register read 1/1, byte for byte the body that
+ * hdmi_reg_read()/frl_reg_read() already send on FLAVA3:
+ *   04 0c 00 01 | 01 08 01 01 <count> <reg_hi> <reg_lo> 00      (count <= 16)
+ * Never sent to VERDE by any kernel before this one: RISK, untested on VERDE.
+ * Any error (ICC error or timeout, bad reply, status != 0) aborts the dump and the boot
+ * goes on normally. At most VSNAP_MAX_READS reads, VSNAP_GAP_MS apart, through the stock
+ * icc_query() (its own 12 s timeout; not shortened, see REPORTE.md).
+ *
+ * 1 = safe list. 2 = also, at the end, the status/IRQ/trigger registers that the research
+ * kept out of the first run because a read could have side effects
+ * (0x11 0x13 0x16 0xf1 0xf2 0x102 0x300a 0x9002).
+ * Output: dmesg lines "VERDE-SNAP ..." and /sys/kernel/debug/verde_snapshot (root, 0400).
+ */
+/*
+ * No MODULE_PARM_DESC and no data tables on purpose: new string/array sizes would add types
+ * to the kernel BTF and shift the type IDs that the stock modules' BTF refers to.
+ */
+static uint verde_snapshot;
+module_param(verde_snapshot, uint, 0444);
+
+#define VSNAP_CHUNK		16
+#define VSNAP_MAX_READS		64
+#define VSNAP_GAP_MS		100
+#define VSNAP_TEXT_SIZE		8192
+#define VSNAP_N_SAFE		17	/* ranges 0..16: level 1; 17..24: level 2 */
+#define VSNAP_N_ALL		25
+
+/* range i = { first register, length }, in this order (doc 07, stage 1, safeguard 4) */
+static __always_inline bool vsnap_range(unsigned int i, unsigned int *reg, unsigned int *len)
+{
+	switch (i) {
+	case 0:  *reg = 0x307a; *len =   8; break;	/* control: Audio InfoFrame (Linux writes 01 0a 70 01 00 00 00 00) */
+	case 1:  *reg = 0x9810; *len =   7; break;	/* control: channel status (Linux writes 00 79 00 02 0b 00 00) */
+	case 2:  *reg = 0x4001; *len =   2; break;	/* control: 0x4001 bit 1 = DP link; 0x4002 */
+	case 3:  *reg = 0x3082; *len = 334; break;	/* hole between Audio IF and SPD: DRM InfoFrame candidate */
+	case 4:  *reg = 0x3000; *len =  10; break;	/* packet control 0x3000-0x3009 (0x300a trigger: level 2) */
+	case 5:  *reg = 0x300b; *len = 119; break;	/* 0x300b-0x3081: send status 0x300c-0x3011, 0x3033, AVI 0x3058, Audio IF */
+	case 6:  *reg = 0x31d0; *len =  48; break;	/* SPD 0x31d0-0x31eb and the rest of the block */
+	case 7:  *reg = 0x9800; *len =  50; break;	/* 0x9800-0x9831 audio / channel status / 0x9830 */
+	case 8:  *reg = 0x0100; *len =   2; break;	/* 0x100-0x101 (0x102 status: level 2) */
+	case 9:  *reg = 0x0103; *len =   6; break;	/* 0x103-0x108: 0x104, 0x105 video mute, 0x108 */
+	case 10: *reg = 0x0400; *len =   1; break;
+	case 11: *reg = 0x3261; *len =   1; break;
+	case 12: *reg = 0x33b3; *len =   1; break;
+	case 13: *reg = 0x8000; *len =   4; break;
+	case 14: *reg = 0x9000; *len =   2; break;	/* 0x9000-0x9001 (0x9002 link-training trigger: level 2) */
+	case 15: *reg = 0x9003; *len =   7; break;	/* DP link 0x9003-0x9009 */
+	case 16: *reg = 0x9200; *len =   1; break;
+	/* level 2: status / IRQ / trigger registers, a read might have side effects */
+	case 17: *reg = 0x0011; *len =   1; break;
+	case 18: *reg = 0x0013; *len =   1; break;
+	case 19: *reg = 0x0016; *len =   1; break;
+	case 20: *reg = 0x00f1; *len =   1; break;
+	case 21: *reg = 0x00f2; *len =   1; break;
+	case 22: *reg = 0x0102; *len =   1; break;
+	case 23: *reg = 0x300a; *len =   1; break;
+	case 24: *reg = 0x9002; *len =   1; break;
+	default: return false;
+	}
+	return true;
 }
 
+static struct debugfs_blob_wrapper vsnap_blob;
+
+/* one 1/1 read of up to VSNAP_CHUNK registers; buf is ICC_MSG_MAX_SIZE bytes */
+static __always_inline int vsnap_read(u8 *buf, u16 reg, u8 count, u8 *out)
+{
+	const u8 body[] = { 0x04, 0x0c, 0x00, 0x01, 0x01, 0x08, 0x01, 0x01, count, reg >> 8, reg & 0xff, 0x00 };
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	memset(buf, 0, ICC_MSG_MAX_SIZE);
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->length = sizeof(*msg) + sizeof(body);
+	memcpy(msg->data, body, sizeof(body));
+	ret = icc_query(buf, buf);
+	if (ret)
+		return ret;
+	if (msg->service_id != ICC_SERVICE_ID_HDMI || msg->length < sizeof(*msg) + 8 + count ||
+	    msg->data[0] || msg->data[1])
+		return -EIO;
+	memcpy(out, msg->data + 8, count);
+	return 0;
+}
+
+#define vsnap_log(text, len, fmt, ...) do {						\
+	pr_info("VERDE-SNAP " fmt "\n", ##__VA_ARGS__);					\
+	if (text)									\
+		len += scnprintf(text + len, VSNAP_TEXT_SIZE - len, fmt "\n", ##__VA_ARGS__); \
+} while (0)
+
+static __always_inline void verde_snapshot_run(void)
+{
+	static bool done;
+	const unsigned int level = READ_ONCE(verde_snapshot);
+	unsigned int reads = 0, bytes = 0, i;
+	ktime_t start;
+	char *text;
+	size_t len = 0;
+	u8 data[VSNAP_CHUNK];
+	u8 *buf;
+	int ret = 0;
+
+	if (!level || done)
+		return;
+	done = true;		/* once per boot: never on a later call */
+	if (hdmi_ic_type != HDMI_IC_TYPE_VERDE) {
+		pr_info("VERDE-SNAP skipped: bridge is not VERDE (type %u)\n", hdmi_ic_type);
+		return;
+	}
+	buf = kmalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	if (!buf)
+		return;
+	text = kzalloc(VSNAP_TEXT_SIZE, GFP_KERNEL);	/* NULL: dmesg only */
+	start = ktime_get();
+
+	vsnap_log(text, len, "start level=%u (read 1/1 only, <=%u bytes per read, max %u reads, %u ms apart)",
+		  level, VSNAP_CHUNK, VSNAP_MAX_READS, VSNAP_GAP_MS);
+	for (i = 0; i < (level >= 2 ? VSNAP_N_ALL : VSNAP_N_SAFE) && !ret; i++) {
+		unsigned int reg, end, n;
+
+		if (!vsnap_range(i, &reg, &n))
+			break;
+		if (i == VSNAP_N_SAFE)
+			vsnap_log(text, len, "level 2: status/trigger registers");
+		for (end = reg + n; reg < end;) {
+			u8 count = min_t(unsigned int, end - reg, VSNAP_CHUNK);
+
+			if (reads >= VSNAP_MAX_READS) {
+				ret = -E2BIG;
+				vsnap_log(text, len, "ABORT: read limit %u reached at %04x", VSNAP_MAX_READS, reg);
+				break;
+			}
+			if (reads)
+				msleep(VSNAP_GAP_MS);
+			reads++;
+			ret = vsnap_read(buf, reg, count, data);
+			if (ret) {
+				/* ICC header + first 8 data bytes (status 2 B) as left in buf, for the report */
+				vsnap_log(text, len, "ABORT at %04x+%u: error %d, buf %*ph", reg, count, ret,
+					  12 + 8, buf);
+				break;
+			}
+			vsnap_log(text, len, "%04x: %*ph", reg, count, data);
+			bytes += count;
+			reg += count;
+		}
+	}
+	vsnap_log(text, len, "%s: %u reads, %u bytes, %lld ms", ret ? "end (aborted)" : "end ok", reads, bytes,
+		  ktime_ms_delta(ktime_get(), start));
+	kfree(buf);
+	if (text) {
+		vsnap_blob.data = text;
+		vsnap_blob.size = len;
+		debugfs_create_blob("verde_snapshot", 0400, NULL, &vsnap_blob);
+	}
+}
+
 void hdmiSystemResume(void)
 {
+	verde_snapshot_run();	/* VERDE-SNAP: does nothing without hdmi.verde_snapshot */
 	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3) {
 		/* Not programmed: on some TVs these make the bridge re-announce during the first modeset and lose video. */
 		i2c_cmd_4_2();
