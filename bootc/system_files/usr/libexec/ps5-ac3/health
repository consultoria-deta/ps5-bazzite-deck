#!/bin/bash
# Runs every 15 s while the 5.1 is enabled. Brings back what fell over and did not come back alone (OOM, session,
# permissions): PipeWire sockets and services, pipewire-pulse, and the ps5-ac3 pipe.
R=$XDG_RUNTIME_DIR; L(){ echo "$(date +%T) $*"; }
# Do not fight the OOM killer while memory is short: wait for the next run.
[ "$(awk "/MemAvailable/{print int(\$2/1024)}" /proc/meminfo)" -lt 300 ] && { L "memory low, waiting"; exit 0; }
for s in pipewire.socket pipewire-pulse.socket pipewire wireplumber; do
  systemctl --user is-active -q $s || { L "starting $s"; systemctl --user reset-failed $s; systemctl --user start $s; }
done
timeout 5 pactl info >/dev/null 2>&1 || { L "pulse does not answer, starting pipewire-pulse"; systemctl --user reset-failed pipewire-pulse; systemctl --user start pipewire-pulse; }
# When PipeWire restarts (new PID), Chromium stays silent until its audio service restarts.
P=$(systemctl --user show pipewire -p MainPID --value)
if [ -f "$R/ps5-ac3-pw-pid" ] && [ "$(cat "$R/ps5-ac3-pw-pid")" != "$P" ] && [ "$P" != 0 ]; then
  L "pipewire restarted ($(cat "$R/ps5-ac3-pw-pid") -> $P): restarting Chromium's audio service"; pkill -f audio.mojom.AudioService
fi
echo "$P" > "$R/ps5-ac3-pw-pid"
# The pipe comes back unless the watchdog stopped it for a bad bit.
S=$(systemctl --user show ps5-ac3 -p ActiveState --value)
if { [ "$S" = inactive ] || [ "$S" = failed ]; } && [ ! -f "$R/ps5-ac3-bad-bit" ]; then
  L "ps5-ac3 inactive, starting it"; systemctl --user reset-failed ps5-ac3; systemctl --user start --no-block ps5-ac3
fi
# Continuous dropouts on the AC-3 output: 30 or more xruns in 15 s restart the pipe.
if systemctl --user is-active -q ps5-ac3; then
  X=$(timeout 4 pw-top -b -n 2 2>/dev/null | awk "/ps5-ac3-out/{id=\$2; e=\$9} END{print id, e}")
  read XID XERR <<< "$X"
  if [ -n "$XERR" ] && [ -f "$R/ps5-ac3-xruns" ]; then
    read PID0 PERR < "$R/ps5-ac3-xruns"
    if [ "$PID0" = "$XID" ] && [ $((XERR - PERR)) -ge 30 ]; then
      L "continuous dropouts on ps5-ac3-out ($PERR -> $XERR in 15 s): restarting the pipe"
      echo "" > "$R/ps5-ac3-xruns"; /usr/bin/ps5-audio-51 restart >/dev/null 2>&1; exit 0
    fi
  fi
  [ -n "$XERR" ] && echo "$XID $XERR" > "$R/ps5-ac3-xruns"
fi
exit 0
